#!/usr/bin/env bash
# Copied for the clean-start tests from the earlier restore-chain stand-in (age is not installed on every machine).
# Local stand-in for age-keygen (age is not installed here): a random 256-bit key.
# The "recipient" carries the same key, so the stand-in is symmetric (AES-256 via openssl).
set -euo pipefail
OUT=
while [ $# -gt 0 ]; do case "$1" in -o) OUT="$2"; shift 2;; *) echo "age-keygen stub: unsupported $1" >&2; exit 2;; esac; done
K=$(openssl rand -hex 32)
KEY="# created: stub
# public key: age1${K}
AGE-SECRET-KEY-1${K}"
if [ -n "$OUT" ]; then umask 077; printf '%s\n' "$KEY" > "$OUT"; else printf '%s\n' "$KEY"; fi
echo "Public key: age1${K}" >&2
