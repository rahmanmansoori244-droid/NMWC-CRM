#!/usr/bin/env bash
# The real date, with three test knobs, in this order of precedence:
#  1. FAKE_UTC_EPOCH answers "now" as seconds (exactly `date -u +%s`), for the
#     unit test of backup-pick's evening-dump rule.
#  2. FAKE_UTC_HHMM answers the evening-window question (exactly
#     `date -u +%H%M`), so the apply path can be tested at any hour.
#  3. FAKE_UTC_OFFSET (below) shifts every call that reads the clock.
# The first two answer only their one exact form; every other call falls
# through to the next knob, and with none set this is the real date.
if [ -n "${FAKE_UTC_EPOCH:-}" ] && [ "$#" -eq 2 ] && [ "$1" = -u ] && [ "$2" = +%s ]; then
  printf '%s\n' "$FAKE_UTC_EPOCH"
  exit 0
fi
if [ -n "${FAKE_UTC_HHMM:-}" ] && [ "$#" -eq 2 ] && [ "$1" = -u ] && [ "$2" = +%H%M ]; then
  printf '%s\n' "$FAKE_UTC_HHMM"
  exit 0
fi
# FAKE_UTC_OFFSET (whole seconds, may be negative): every call that READS the
# clock answers the real time plus the offset (the clean-start flow test's
# pinned clock). A call given a time (-d/--date, -r/--reference, -f/--file) is
# the real date, unchanged, so derived dates follow the faked "now".
if [ -n "${FAKE_UTC_OFFSET:-}" ]; then
  reads=1
  for a in "$@"; do
    case "$a" in -d|-d?*|--date|--date=*|-r|-r?*|--reference|--reference=*|-f|-f?*|--file|--file=*) reads=0 ;; esac
  done
  if [ "$reads" = 1 ]; then exec /usr/bin/date -d "@$(( $(/usr/bin/date -u +%s) + FAKE_UTC_OFFSET ))" "$@"; fi
fi
exec /usr/bin/date "$@"
