// NMWC Customer Master — Prisma schema
// Full v1 data model. See docs/TECH-SPEC.md §3.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── ENUMS ────────────────────────────────────────────────
enum Role {
  SALESMAN
  SUPERVISOR
  ACCOUNTANT // Phase 1: final approver on both create chains (region-scoped)
  FINANCE_MANAGER // Phase 1: credit-chain approver (org-wide)
  GM // Phase 1: credit-chain approver (org-wide)
  MANAGER
  STEWARD
  VIEWER
}

enum PaymentTerms {
  CASH
  CREDIT
}

enum CustomerStatus {
  ACTIVE
  CLOSED
  SUSPENDED
}

enum DayOfWeek {
  SAT
  SUN
  MON
  TUE
  WED
  THU
  FRI
}

enum EditState {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  NEEDS_CORRECTION
}

enum EditTarget {
  CUSTOMER
  BRANCH
}

enum AttachmentKind {
  SHOP
  SIGNBOARD
  CR
  GUARANTEE // Phase 1: credit guarantee / security document (1:N per customer)
  FREE
}

enum ImportRowState {
  PENDING
  CLEAN
  QUARANTINED
  PROMOTED
  REJECTED
}

enum AuditAction {
  CREATE
  UPDATE
  APPROVE
  REJECT
  IMPORT
  MERGE
  REASSIGN
  CLOSE
  REACTIVATE
  LOGIN
  LOGOUT
  FORCE_OVERRIDE
  // Senior-audit B-03/B-04: granular auth + delete + photo-view actions
  LOGIN_FAIL
  SESSION_REVOKE
  DELETE
  SOFT_DELETE
  PHOTO_VIEW
  // Phase 1: multi-step approval, escalation, and export actions
  STEP_APPROVE
  FINALIZE
  ESCALATE
  EXPORT
}

enum ImportBatchStatus {
  PARSING
  READY
  PROMOTING
  PROMOTED
  FAILED
}

enum ExportJobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

// ── Phase 1: unified-CRM enums ───────────────────────────
enum EditProcess {
  UPDATE // existing-customer enrichment/correction (1-step: Supervisor)
  CREATE // net-new onboarding (cash: SUP→ACC; credit: SUP→FM→GM→ACC)
}

// Batch upload-to-Temix queue state on Customer.
enum TemixSyncState {
  SYNCED // matches Temix as of last upload/refresh (default for migrated rows)
  PENDING_UPLOAD // approved create/correction not yet exported to Temix
  UPLOADED // in an exported batch; awaiting Steward "loaded" confirm / inbound refresh
  DEACTIVATE_PENDING // soft-deleted: flag for deactivation in Temix on next upload
}

enum NotificationKind {
  EDIT_SUBMITTED // to the first approver
  EDIT_STAGE_ADVANCED // to the next approver in the chain
  EDIT_APPROVED_FINAL // to submitter (+ Stewards: ready for Temix upload)
  EDIT_NEEDS_CORRECTION // to submitter (carries decisionReason)
  SLA_BREACH // to the escalation target
  TEMIX_UPLOAD_READY // to Stewards, DEBOUNCED (max 1/day via cron) — queue non-empty
  TEMIX_SYNC_ACKED // to the submitter: their customer landed in Temix (code assigned)
}

// ── ORG HIERARCHY ────────────────────────────────────────
model Region {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routes       Route[]
  branches     Branch[]
  managers     User[]            @relation("ManagerRegions")
  branchDrafts EditBranchDraft[] @relation("DraftRegion")
}

model Route {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  regionId  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  region       Region            @relation(fields: [regionId], references: [id])
  owner        User?             @relation("RouteOwner")
  branches     Branch[]
  branchDrafts EditBranchDraft[] @relation("DraftRoute")

  @@unique([regionId, code])
  @@index([regionId])
}

// ── USERS ────────────────────────────────────────────────
model User {
  id                 String    @id @default(cuid())
  username           String    @unique
  passwordHash       String
  fullName           String
  role               Role
  isActive           Boolean   @default(true)
  email              String?   @unique
  phone              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  lastLoginAt        DateTime?
  // AUTH-12 / AUTH-01 / AUTH-02: bumped on logout, disable, role change, password
  // reset. JWT freshness check rejects tokens whose `iat * 1000` is older than
  // this timestamp. Allows immediate session revocation without an 8h JWT TTL.
  sessionsRevokedAt  DateTime?
  // AUTH-09: forces redirect to /profile/change-password on next login. Cleared
  // by a successful change-password action.
  mustChangePassword Boolean   @default(false)

  // Hierarchy
  supervisorId String?
  supervisor   User?   @relation("UserHierarchy", fields: [supervisorId], references: [id])
  reports      User[]  @relation("UserHierarchy")

  // Salesman owns exactly one route (1:1)
  ownedRouteId String? @unique
  ownedRoute   Route?  @relation("RouteOwner", fields: [ownedRouteId], references: [id])

  // Manager regions (M:N)
  managedRegions Region[] @relation("ManagerRegions")

  auditLogs           AuditLog[]
  submittedEdits      CustomerEdit[]    @relation("EditSubmitter")
  reviewedEdits       CustomerEdit[]    @relation("EditReviewer")
  capturedAttachments Attachment[]      @relation("AttachmentCapturer")
  uploadedImports     ImportBatch[]     @relation("ImportUploader")
  reviewedImports     ImportRow[]       @relation("ImportReviewer")
  excludedImports     ImportRow[]       @relation("ImportExcluder")
  requestedExports    ExportJob[]       @relation("ExportRequester")
  // B-15: previous password hashes used to block reuse on change-password.
  passwordHistory     PasswordHistory[]
  // P2.2 (2026-05-10): per-user saved /customers filter views.
  savedViews          SavedView[]
  // Phase 1: multi-step approval decisions, notifications, Temix batches.
  stepDecisions       EditApproval[]    @relation("StepActor")
  notifications       Notification[]    @relation("UserNotifications")
  temixSyncBatches    TemixSyncBatch[]  @relation("TemixBatchCreator")

  @@index([role, isActive])
}

// B-15: Password reuse prevention. New change-password flow rejects any hash
// that matches the user's most-recent N entries. Service layer prunes old
// rows; the index supports the "last N for this user" lookup.
model PasswordHistory {
  id        String   @id @default(cuid())
  userId    String
  hash      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

// P2.2 (2026-05-10): saved filter views for the /customers list. Each row is a
// named snapshot of a user's URL search params. Per-user only — there is no
// "share with team" flow yet. Index supports "list my views, newest first".
model SavedView {
  id        String   @id @default(cuid())
  userId    String
  name      String
  urlParams String   @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

// ── CHANNELS (locked taxonomy from PRD Appendix A) ──────
model Channel {
  id           String   @id @default(cuid())
  key          String   @unique
  label        String
  displayOrder Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  subChannels SubChannel[]
  customers   Customer[]
  drafts      EditCustomerDraft[] @relation("DraftChannel")
}

model SubChannel {
  id        String   @id @default(cuid())
  key       String
  label     String
  channelId String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  channel   Channel             @relation(fields: [channelId], references: [id])
  customers Customer[]
  drafts    EditCustomerDraft[] @relation("DraftSubChannel")

  @@unique([channelId, key])
}

// ── CUSTOMER & BRANCH ─────────────────────────────────
model Customer {
  id                String         @id @default(cuid())
  nmwcCode          String         @unique
  legalName         String
  paymentTerms      PaymentTerms   @default(CASH)
  crNumber          String?
  crNumberNorm      String? // normalized for dedupe
  channelId         String?
  subChannelId      String?
  primaryPhone      String?
  primaryPhoneNorm  String? // normalized; partial unique index added in migration SQL
  altPhone          String?
  contactPerson     String?
  contactRole       String?
  status            CustomerStatus @default(ACTIVE)
  notes             String?        @db.Text
  completenessScore Int            @default(0)

  // B-05: optimistic locking. Service layer increments on every UPDATE and
  // includes `version` in the WHERE clause to detect concurrent edits.
  version Int @default(0)

  // Lineage
  importBatchId String?
  importRowId   String? @unique

  // CR photo lives here (legal entity attribute)
  crPhotoId String? @unique

  // Phase 1: credit onboarding data (paymentTerms == CREDIT). Written at finalize
  // from the salesman's REQUESTED values — FM/GM approve/reject, never amend.
  creditLimit     Decimal? @db.Decimal(14, 3)
  paymentTermDays Int?

  // Phase 1: Temix (ERP) crosswalk + batch-upload queue. nmwcCode == temixCode
  // for migrated rows, so temixCode is nullable + NON-unique (H-01); a partial
  // unique index is added later once the Steward confirms crosswalk cleanliness.
  temixCode              String?
  temixSyncState         TemixSyncState @default(SYNCED)
  temixSyncPendingSince  DateTime?
  lastTemixUploadAt      DateTime?
  lastTemixUploadBatchId String?

  // Audit
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  lastEditedById String?
  deletedAt      DateTime?

  channel    Channel?    @relation(fields: [channelId], references: [id])
  subChannel SubChannel? @relation(fields: [subChannelId], references: [id])
  importRow  ImportRow?  @relation(fields: [importRowId], references: [id])
  crPhoto    Attachment? @relation("CrPhoto", fields: [crPhotoId], references: [id])

  branches Branch[]
  edits    CustomerEdit[]

  @@index([status, deletedAt])
  @@index([channelId])
  @@index([legalName])
  @@index([paymentTerms])
  @@index([temixCode])
  @@index([temixSyncState])
}

model Branch {
  id              String  @id @default(cuid())
  customerId      String
  branchCode      String  @unique
  branchName      String
  regionId        String
  routeId         String
  address         String  @db.Text
  areaDescription String? @db.Text

  gpsLat        Float?
  gpsLng        Float?
  gpsAccuracy   Float?
  gpsCapturedAt DateTime?

  dayOfVisit     DayOfWeek?
  openingHours   String?
  deliveryWindow String?

  coolersCount      Int @default(0)
  standsCount       Int @default(0)
  emptyBottlesCount Int @default(0)

  shopPhotoId      String? @unique
  signboardPhotoId String? @unique

  status             CustomerStatus @default(ACTIVE)
  completenessScore  Int            @default(0)
  // EL-11/EL-12: stamped whenever `status` changes. Reactivation evidence must
  // have `attachment.capturedAt > lastStatusChangeAt`, so a salesman cannot
  // reuse a pre-closure photo to "prove" a reopening.
  lastStatusChangeAt DateTime?

  // B-05: optimistic locking. Service layer increments on every UPDATE and
  // includes `version` in the WHERE clause to detect concurrent edits.
  version Int @default(0)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  lastEditedById String?
  deletedAt      DateTime?

  customer       Customer    @relation(fields: [customerId], references: [id])
  region         Region      @relation(fields: [regionId], references: [id])
  route          Route       @relation(fields: [routeId], references: [id])
  shopPhoto      Attachment? @relation("ShopPhoto", fields: [shopPhotoId], references: [id])
  signboardPhoto Attachment? @relation("SignboardPhoto", fields: [signboardPhotoId], references: [id])

  extraPhotos Attachment[]   @relation("BranchExtraPhotos")
  edits       CustomerEdit[]

  @@index([routeId, status, deletedAt])
  @@index([customerId])
  @@index([regionId])
}

// ── EDITS / APPROVAL ─────────────────────────────────
model CustomerEdit {
  id                String     @id @default(cuid())
  target            EditTarget
  customerId        String?
  branchId          String?
  state             EditState  @default(DRAFT)
  submittedById     String
  submittedAt       DateTime?
  reviewedById      String?
  reviewedAt        DateTime?
  decisionReason    String?    @db.Text
  decisionCategory  String?
  fieldChanges      Json
  attachmentChanges Json
  isReactivation    Boolean    @default(false)
  isWrongRoute      Boolean    @default(false)
  newRouteId        String?

  // Item 22: the id the phone minted for this submit. A retry carrying an id the
  // submitter already sent is answered with this row's receipt, never written
  // twice (lib/submission-replay.ts). Null for rows no field form wrote.
  submissionId      String?

  // Phase 1: net-new CREATE support (customerId is null for a CREATE request;
  // the proposed payload lives in EditCustomerDraft + EditBranchDraft[]).
  process EditProcess @default(UPDATE)

  // Phase 1: multi-step approval chain, resolved from the matrix + frozen at
  // submit. pendingRole is denormalized for queue/SLA/notification queries.
  paymentTermsAtSubmit PaymentTerms?
  approvalChain        Json?
  currentStepIndex     Int           @default(0)
  pendingRole          Role?
  cycle                Int           @default(1)

  // Phase 1: credit application (CREATE-CREDIT). FM/GM approve/reject these
  // REQUESTED values — no amendment (owner-confirmed).
  requestedCreditLimit     Decimal? @db.Decimal(14, 3)
  requestedPaymentTermDays Int?

  // Phase 1: SLA / escalation for the current step.
  stageEnteredAt  DateTime?
  slaDueAt        DateTime?
  slaBreachedAt   DateTime?
  escalationLevel Int       @default(0)
  lastEscalatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer    Customer? @relation(fields: [customerId], references: [id])
  branch      Branch?   @relation(fields: [branchId], references: [id])
  submittedBy User      @relation("EditSubmitter", fields: [submittedById], references: [id])
  reviewedBy  User?     @relation("EditReviewer", fields: [reviewedById], references: [id])

  // Phase 1 relations
  customerDraft EditCustomerDraft?
  branchDrafts  EditBranchDraft[]
  steps         EditApproval[]
  notifications Notification[]
  attachments   Attachment[]       @relation("EditAttachments")

  @@index([state, submittedAt])
  @@index([submittedById, state])
  @@index([customerId, state])
  @@index([branchId, state])
  @@index([pendingRole, state])
  @@index([state, slaDueAt])
  @@unique([submittedById, submissionId])
}

// ── ATTACHMENTS ──────────────────────────────────────
model Attachment {
  id            String         @id @default(cuid())
  kind          AttachmentKind
  customerId    String?
  branchId      String?
  // Used by Branch.extraPhotos relation
  branchExtraId String?
  // Phase 1: photos captured during a net-new CREATE before the Customer/Branch
  // exists; bound to real slots at finalize. NOT swept when the draft is
  // abandoned — services/creates.ts releases editId-claimed photos only on a
  // re-submit of the same edit row, so a request left in DRAFT or
  // NEEDS_CORRECTION forever keeps its photos forever. No cron covers this
  // (DG-03/04): an abandoned-draft sweep needs an owner-chosen period first.
  editId        String?
  r2Key         String         @unique
  mimeType      String
  bytes         Int
  width         Int?
  height        Int?
  capturedById  String
  capturedAt    DateTime
  capturedLat   Float?
  capturedLng   Float?
  hash          String?
  createdAt     DateTime       @default(now())
  // UXI-008: real soft-delete column. Replaces the previous "rename r2Key to
  // __deleted__/..." sentinel — every Attachment lookup now filters on
  // `deletedAt: null` so soft-deleted rows can never satisfy fresh-photo or
  // scope checks.
  deletedAt     DateTime?

  capturedBy  User          @relation("AttachmentCapturer", fields: [capturedById], references: [id])
  branchExtra Branch?       @relation("BranchExtraPhotos", fields: [branchExtraId], references: [id])
  edit        CustomerEdit? @relation("EditAttachments", fields: [editId], references: [id])

  // Inverse relations to single-photo slots
  customerCrPhoto      Customer? @relation("CrPhoto")
  branchShopPhoto      Branch?   @relation("ShopPhoto")
  branchSignboardPhoto Branch?   @relation("SignboardPhoto")

  @@index([branchId])
  @@index([customerId])
  @@index([branchExtraId])
  @@index([editId])
  @@index([deletedAt])
  @@index([hash])
}

// ── IMPORT ──────────────────────────────────────────
model ImportBatch {
  id              String            @id @default(cuid())
  filename        String
  kind            String            @default("CUSTOMER") // "CUSTOMER" or "ACCOUNT"
  uploadedById    String
  uploadedAt      DateTime          @default(now())
  // B-18: typed status enum (was loose string).
  status          ImportBatchStatus
  totalRows       Int               @default(0)
  cleanRows       Int               @default(0)
  quarantinedRows Int               @default(0)
  promotedRows    Int               @default(0)
  rejectedRows    Int               @default(0)

  // RK-3: a full customer master (~3,300 rows) cannot be promoted inside the 60s
  // function limit, so promote runs in time-boxed slices and the batch is resumed
  // until no CLEAN rows remain. The lease is a compare-and-set token: only one
  // worker may hold a batch at a time, and it EXPIRES (deliberately longer than
  // the function limit) so a killed worker can never strand the batch.
  promoteLeaseBy    String?
  promoteLeaseUntil DateTime?

  uploadedBy User        @relation("ImportUploader", fields: [uploadedById], references: [id])
  rows       ImportRow[]

  // Resume picks a batch up by (status, lease) — index the pair the claim filters on.
  @@index([status, promoteLeaseUntil])
}

model ImportRow {
  id             String         @id @default(cuid())
  batchId        String
  rowNumber      Int
  raw            Json
  parsed         Json?
  state          ImportRowState @default(PENDING)
  issues         Json?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime       @default(now())
  // Item 20: cells the Steward corrected in the app; raw stays as uploaded.
  corrections    Json?
  // Item 20: "accepted as excluded" — a column so the 90-day sweep of issues cannot undo it.
  excludedAt     DateTime?
  excludedById   String?
  excludedReason String?

  batch            ImportBatch @relation(fields: [batchId], references: [id])
  reviewedBy       User?       @relation("ImportReviewer", fields: [reviewedById], references: [id])
  excludedBy       User?       @relation("ImportExcluder", fields: [excludedById], references: [id])
  promotedCustomer Customer?

  @@index([batchId, state])
}

// ── CRON HEARTBEATS ─────────────────────────────────
// B5: one row per scheduled job, upserted when the job finishes (success or
// failure). The bearer /api/health probe turns these into stale / never-ran
// alarms (lib/heartbeat.ts). Keys: sla-escalate, keep-warm, photo-gc.
model CronHeartbeat {
  key            String   @id
  lastRunAt      DateTime
  lastOk         Boolean  @default(true)
  lastDurationMs Int?
  lastError      String?
  lastDetail     Json?
  runs           Int      @default(0)
  failures       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ── RATE LIMIT ──────────────────────────────────────
// QA-015: durable rate limiter that survives across Vercel function instances.
// Token-bucket: each row holds the bucket's current tokens and the last refill
// time. Reads/writes happen in a single SQL UPDATE to avoid race conditions.
model RateLimit {
  key        String   @id
  // MUST stay a floating type. checkLimitPg (lib/rate-limit.ts) stores a
  // fractional refill and a -1 "denied" marker; an integer column would
  // truncate both and silently re-break the SEC-C3 fix (limiter would stop
  // denying / mis-report retryAfterSec).
  tokens     Float    @default(0)
  lastRefill DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ── EXPORT ──────────────────────────────────────────
model ExportJob {
  id            String          @id @default(cuid())
  requestedById String
  filters       Json
  // B-18: typed status enum (was loose string).
  status        ExportJobStatus
  r2Key         String?
  rowCount      Int?
  startedAt     DateTime        @default(now())
  completedAt   DateTime?
  errorMessage  String?

  requestedBy User @relation("ExportRequester", fields: [requestedById], references: [id])
}

// ── AUDIT (immutable) ────────────────────────────────────
model AuditLog {
  id         String      @id @default(cuid())
  actorId    String
  action     AuditAction
  entityType String
  entityId   String
  before     Json?
  after      Json?
  reason     String?
  ip         String?
  userAgent  String?
  at         DateTime    @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId, at(sort: Desc)])
  @@index([actorId, at(sort: Desc)])
  @@index([action, at(sort: Desc)])
  // SCALE: the three composites all lead with a column, so "the most recent
  // audit rows, whoever wrote them" — the audit page's default view and every
  // forensic query that starts from a time window — had no index to use and
  // scanned a table that grows forever.
  @@index([at(sort: Desc)])
}

// ── Phase 1: CREATE-request drafts, multi-step approval, SLA/notifications, Temix sync ──

// Typed payload for a not-yet-existing customer. A CREATE CustomerEdit
// (customerId = null) carries one of these (1:1) + >= 1 EditBranchDraft. Real
// Customer/Branch rows are produced from these at finalize. Real FKs + replicated
// DB CHECKs (migration) so net-new masters get the same validation as live rows.
model EditCustomerDraft {
  id                  String       @id @default(cuid())
  editId              String       @unique
  legalName           String
  paymentTerms        PaymentTerms // routing key: CASH vs CREDIT chain
  crNumber            String?
  crNumberNorm        String? // create-time dedup key
  channelId           String?
  subChannelId        String?
  primaryPhone        String?
  primaryPhoneNorm    String?
  altPhone            String?
  contactPerson       String?
  contactRole         String?
  notes               String?      @db.Text
  crPhotoAttachmentId String?      @unique

  edit       CustomerEdit @relation(fields: [editId], references: [id], onDelete: Cascade)
  channel    Channel?     @relation("DraftChannel", fields: [channelId], references: [id])
  subChannel SubChannel?  @relation("DraftSubChannel", fields: [subChannelId], references: [id])

  @@index([crNumberNorm])
  @@index([primaryPhoneNorm])
}

// Proposed branch row(s) under a CREATE request. Mirrors Branch minus branchCode
// (allocated at finalize) and photo-slot FKs (unbound attachment ids instead).
model EditBranchDraft {
  id                         String     @id @default(cuid())
  editId                     String
  branchName                 String
  regionId                   String
  routeId                    String
  address                    String     @db.Text
  areaDescription            String?    @db.Text
  gpsLat                     Float?
  gpsLng                     Float?
  gpsAccuracy                Float?
  gpsCapturedAt              DateTime?
  dayOfVisit                 DayOfWeek?
  openingHours               String?
  deliveryWindow             String?
  coolersCount               Int        @default(0)
  standsCount                Int        @default(0)
  emptyBottlesCount          Int        @default(0)
  shopPhotoAttachmentId      String?
  signboardPhotoAttachmentId String?
  extraPhotoAttachmentIds    Json? // string[] of unbound Attachment ids

  edit   CustomerEdit @relation(fields: [editId], references: [id], onDelete: Cascade)
  region Region       @relation("DraftRegion", fields: [regionId], references: [id])
  route  Route        @relation("DraftRoute", fields: [routeId], references: [id])

  @@index([editId])
}

// Per-step approval decision — APPEND-ONLY. Under the owner-confirmed step-back
// cascade a single step can be decided more than once per cycle (approve →
// stepped back → re-approve), so this is a log ordered by time, NOT unique per
// (edit, step). AuditLog stays the immutable forensic record; this powers the
// queue / SLA / notification queries and per-step history.
model EditApproval {
  id        String   @id @default(cuid())
  editId    String
  cycle     Int
  stepIndex Int
  role      Role
  decision  String // 'APPROVED' | 'REJECTED'
  actorId   String
  reason    String?  @db.Text
  at        DateTime @default(now())

  edit  CustomerEdit @relation(fields: [editId], references: [id], onDelete: Cascade)
  actor User         @relation("StepActor", fields: [actorId], references: [id])

  @@index([editId, at(sort: Desc)])
  @@index([actorId])
}

// In-app + email notification. Row exists ⇒ visible in-app; emailedAt marks the
// email batch-drain queue. Body is PII-safe (legalName + nmwcCode + deep link).
model Notification {
  id         String           @id @default(cuid())
  userId     String
  kind       NotificationKind
  title      String
  body       String           @db.Text
  editId     String?
  customerId String?
  readAt     DateTime?
  emailedAt  DateTime?
  createdAt  DateTime         @default(now())

  user User          @relation("UserNotifications", fields: [userId], references: [id])
  edit CustomerEdit? @relation(fields: [editId], references: [id])

  @@index([userId, readAt])
  @@index([emailedAt, createdAt])
  @@index([editId])
}

// Snapshot of one Temix upload batch (modeled on ExportJob). Outbound queue rows
// flip PENDING_UPLOAD → UPLOADED at export; markedLoadedAt once the Steward
// confirms Temix ingested the batch.
model TemixSyncBatch {
  id             String          @id @default(cuid())
  createdById    String
  createdAt      DateTime        @default(now())
  rowCount       Int             @default(0)
  customerIds    Json
  status         ExportJobStatus @default(PENDING)
  r2Key          String?
  markedLoadedAt DateTime?

  createdBy User @relation("TemixBatchCreator", fields: [createdById], references: [id])
}

// Atomic per-scope counter for app-minted provisional codes (NMWC-YYYY-NNNNNN),
// allocated at finalize. Finally wires lib/codes.ts formatCustomerCode.
model CodeSequence {
  scope String @id
  next  Int    @default(1)
}
