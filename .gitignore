# Dependencies
node_modules
.pnpm-store

# Next.js
.next
out
build
dist
tsconfig.tsbuildinfo
*.tsbuildinfo

# Env: every env file, whatever it is named (B7.1), so a file copied in from the
# private pack or during a move cannot be staged. Only the template is tracked.
.env*
*.env
*.env.local
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage
playwright-report
test-results
playwright/.cache
# Bad-href probes written and deleted by tests/unit/typed-routes-guard.test.ts;
# one outlives only a killed run.
/tests/typed-routes-probe-*/

# Editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea
*.swp
.DS_Store
Thumbs.db

# Vercel
.vercel/output
.vercel/cache

# Sentry
.sentryclirc

# Prisma
prisma/*.db
prisma/*.db-journal

# Local R2 cache
.r2-cache
.claude/

# graphify: temp corpus + machine-specific internals (keep graph.json/report/html)
/graphify-corpus/
/graphify-out/.graphify_python
/graphify-out/.graphify_root
/graphify-out/cache/

# Go-live master data built from the real Temix/RoutePro/dashboard sources.
# Contains customer PII and generated credentials — NEVER commit.
/golive-data/

# Local dump artefacts from testing the backup pipeline.
#
# Scoped to the repository ROOT on purpose. A bare `*.sql` matches at every
# depth, which silently ignored prisma/migrations/**/migration.sql — existing
# migrations stayed tracked (gitignore does not untrack), so nothing broke
# visibly, but every NEW migration would have been dropped on the floor and the
# schema would have drifted from the database with no error anywhere.
/*.sql
/*.sql.gz
/*.sql.gz.age
/sigpipetest/

# Operator scripts copied into a checkout to run against production (prod-run.cjs).
# They read private files and must never be committed; delete them after use too.
*.tmp.ts

# Launch e2e (playwright.launch.config.ts): crash registry and server logs.
# Kept OUTSIDE test-results/ so a later run cannot wipe a crashed run's registry.
/.e2e-launch/
