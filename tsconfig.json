{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    },
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  // Never add ".next" here. `exclude` filters the `include` globs above, so it
  // silently dropped .next/types/link.d.ts (what makes `typedRoutes` check any
  // href) and validator.ts (route handler and layout checks), and every route
  // went unchecked. Nothing outside .next/types is reached: the `**` globs skip
  // dot-directories. Pinned by tests/unit/typed-routes-guard.test.ts.
  "exclude": ["node_modules", "dist", "playwright-report", "test-results"]
}
