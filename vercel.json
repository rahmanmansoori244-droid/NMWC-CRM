{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "iad1"
  ],
  "functions": {
    "app/**/*.ts": {
      "maxDuration": 60
    },
    "app/**/*.tsx": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/photo-gc",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/retention-sweep",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/keep-warm",
      "schedule": "*/4 3-14 * * *"
    },
    {
      "path": "/api/cron/sla-escalate",
      "schedule": "15,45 3-14 * * *"
    },
    {
      "path": "/api/cron/email-drain",
      "schedule": "*/10 3-14 * * *"
    }
  ]
}
