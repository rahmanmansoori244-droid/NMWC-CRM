# ============================================================
# NMWC Customer Master — Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local.
# ============================================================

# Node env (set automatically by Vercel; only override locally)
NODE_ENV=development

# ── Database (Neon Postgres) ────────────────────────────────
# Pooled connection used at runtime
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
# Direct connection used for prisma migrate
DIRECT_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ── Auth.js (v5) ────────────────────────────────────────────
# Auth.js v5 reads AUTH_SECRET (NEXTAUTH_SECRET kept for compatibility — set
# BOTH to the same value). Generate via: openssl rand -base64 32
# NOTE: rotating this invalidates every existing session (forces re-login).
AUTH_SECRET=
NEXTAUTH_SECRET=
# In production: https://nmwc-cm.vercel.app
NEXTAUTH_URL=http://localhost:3000

# ── Operational secrets (REQUIRED in production) ────────────
# Cron auth: the SLA-escalation / photo-GC / keep-warm routes reject requests
# whose `Authorization: Bearer <CRON_SECRET>` does not match. MISSING/blank in
# production silently leaves those endpoints unauthenticated — always set it.
CRON_SECRET=
# Bearer token guarding the detailed /api/health probe (basic liveness stays open).
HEALTH_BEARER=
# Kill switch for seeded demo accounts. Set to "true" in production so the demo
# logins cannot be used against real data.
DEMO_ACCOUNTS_DISABLED=true
# Rate-limit backend: "pg" (durable, use in production) or "memory" (dev only).
RATE_LIMIT_BACKEND=pg

# ── Cloudflare R2 ───────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nmwc-photos
# Optional: public base URL if serving photos via R2 public bucket
R2_PUBLIC_BASE=

# ── Sentry ──────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Set in CI/Vercel only (not locally) for source map uploads
SENTRY_AUTH_TOKEN=

# ── Working-hours calendar + SLA (Oman) ─────────────────────
# These drive SLA deadlines and escalation. Defaults shown; all optional.
# WORK_TZ_OFFSET_MIN: minutes east of UTC. Asia/Muscat = UTC+4 = 240 (no DST).
WORK_TZ_OFFSET_MIN=240
# WORK_DAYS: comma-separated weekday numbers that COUNT as working days
#   (0=Sun 1=Mon 2=Tue 3=Wed 4=Thu 5=Fri 6=Sat).
# ⚠ BUSINESS DECISION — confirm NMWC's actual workweek before go-live:
#   • 6-day (private-sector, Friday off, DEFAULT): 0,1,2,3,4,6
#   • 5-day (Sun–Thu, government style):           0,1,2,3,4
# A wrong value miscalculates every SLA deadline and escalation.
WORK_DAYS=0,1,2,3,4,6
# Working-day window (24h clock, local time). SLA time only accrues in-window.
WORK_HOUR_START=8
WORK_HOUR_END=17
# Per-step SLA budgets in MINUTES (business-time). Defaults in comments.
SLA_SUPERVISOR_MIN=480   # 8h
SLA_ACCOUNTANT_MIN=540   # 9h
SLA_MANAGER_MIN=960      # 16h
SLA_FINANCE_MIN=960      # 16h
SLA_GM_MIN=1440          # 24h

# ── Optional: log level (trace|debug|info|warn|error|fatal) ──
LOG_LEVEL=info
