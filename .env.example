# ============================================================
# NMWC Customer Master — Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local.
# ============================================================

# Node env (set automatically by Vercel; only override locally)
NODE_ENV=development

# ── Database (Neon Postgres) ────────────────────────────────
# Pooled connection used at runtime — the LEAST-PRIVILEGE role `nmwc_app`
# (docs/OPERATIONS.md §5c; scripts/ops/app-role.ts). It cannot run DDL and can
# only INSERT into AuditLog / EditApproval.
DATABASE_URL=postgresql://nmwc_app:password@host-pooler.neon.tech/dbname?sslmode=require
# Direct connection with the OWNER role — used only by `prisma migrate deploy`
# (Vercel build), the nightly backup and Steward maintenance scripts.
DIRECT_URL=postgresql://neondb_owner:password@host.neon.tech/dbname?sslmode=require

# ── Auth.js (v5) ────────────────────────────────────────────
# Auth.js v5 reads AUTH_SECRET (NEXTAUTH_SECRET kept for compatibility — set
# BOTH to the same value). Generate via: openssl rand -base64 32
# NOTE: rotating this invalidates every existing session (forces re-login).
AUTH_SECRET=
NEXTAUTH_SECRET=
# In production: https://nmwc-cm.vercel.app
NEXTAUTH_URL=http://localhost:3000

# ── Operational secrets (REQUIRED in production) ────────────
# Cron auth: the SLA-escalation / photo-GC / keep-warm / retention routes reject
# requests whose `Authorization: Bearer <CRON_SECRET>` does not match. If it is
# missing or blank the routes FAIL CLOSED and refuse everyone with 401 —
# lib/cron-auth.ts returns false when the variable is unset. This note used to
# claim the opposite, that a missing secret "silently leaves those endpoints
# unauthenticated"; it did not, and a reader who trusted that could have
# "fixed" the code to match and opened every scheduled route to the internet.
# Set it anyway: without it nothing scheduled can run at all.
# The SAME value must also be set as the PROD_CRON_SECRET GitHub Actions secret.
CRON_SECRET=
# Bearer token guarding the detailed /api/health probe (basic liveness stays open).
HEALTH_BEARER=
# Kill switch for seeded demo accounts. Set to "true" in production so the demo
# logins cannot be used against real data.
DEMO_ACCOUNTS_DISABLED=true
# Rate-limit backend: "pg" (durable, use in production) or "memory" (dev only).
RATE_LIMIT_BACKEND=pg

# ── Outbound alerts (GAP-2, 2026-09-24) ─────────────────────
# ONE https URL that accepts a JSON POST: a Slack or Teams incoming webhook, a
# Discord webhook, or a WhatsApp bridge. Nothing in this system could reach a
# person who was not looking at a screen until this existed.
# UNSET IS A VALID STATE — lib/alert.ts no-ops silently and returns false, and no
# caller changes behaviour. What it costs while unset: an SLA escalation, a failed
# cron and an import that rejected rows are each visible only to somebody who goes
# looking for them.
# Treat the URL as a CREDENTIAL — whoever holds it can post into the channel. It
# is never logged, and it must not be pasted into a ticket or a screenshot.
# It is a Vercel runtime variable and NOT a GitHub Actions secret, so it does not
# belong in lib/ops/required-secrets.ts: that list is the workflows' contract and
# its drift test fails on any name the workflows do not read.
# What each alert means at 3am: docs/OPERATIONS.md §5f.
ALERT_WEBHOOK_URL=

# ── Maintenance mode (REL-02) ───────────────────────────────
# Set to "on" and REDEPLOY to close the app to everyone: field users see a
# bilingual 503, while /api/health, /api/cron/*, /api/ops/* and /api/auth/*
# keep working. Set the bypass token and the matching nmwc_maintenance_bypass
# cookie to keep working yourself. See docs/OPERATIONS.md §6.8.
MAINTENANCE_MODE=
MAINTENANCE_BYPASS_TOKEN=

# ── Cloudflare R2 ───────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nmwc-photos
# Optional: public base URL if serving photos via R2 public bucket
R2_PUBLIC_BASE=

# ── Sentry ──────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Set in CI/Vercel only (not locally) for source map uploads.
# NOTE (DO-04, 2026-09-15): these three are read by NOTHING today. They only
# take effect once next.config.ts is wrapped in withSentryConfig, which is
# deferred until an owner creates a Sentry auth token. Until then browser stack
# traces are minified — errors are captured, but the frames are unreadable.
SENTRY_AUTH_TOKEN=
# Derived at build time in next.config.ts from VERCEL_ENV and the commit SHA.
# Do not set these by hand.
# NEXT_PUBLIC_SENTRY_ENV=
# NEXT_PUBLIC_SENTRY_RELEASE=

# ── Working-hours calendar + SLA (Oman) ─────────────────────
# These drive SLA deadlines and escalation. Defaults shown; all optional.
# WORK_TZ_OFFSET_MIN: minutes east of UTC. Asia/Muscat = UTC+4 = 240 (no DST).
WORK_TZ_OFFSET_MIN=240
# WORK_DAYS: comma-separated weekday numbers that COUNT as working days
#   (0=Sun 1=Mon 2=Tue 3=Wed 4=Thu 5=Fri 6=Sat).
# Owner-confirmed workweek: Sun–Thu (5-day, Friday + Saturday off) = DEFAULT.
#   • 5-day (Sun–Thu, owner-confirmed):  0,1,2,3,4   ← current default
#   • 6-day (private-sector, Friday off): 0,1,2,3,4,6
# A wrong value miscalculates every SLA deadline and escalation.
WORK_DAYS=0,1,2,3,4
# Working-day window (24h clock, local time). SLA time only accrues in-window.
WORK_HOUR_START=8
WORK_HOUR_END=17
# Per-step SLA budgets in MINUTES (business-time). Defaults in comments.
SLA_SUPERVISOR_MIN=480   # 8h
SLA_ACCOUNTANT_MIN=540   # 9h
SLA_MANAGER_MIN=960      # 16h
SLA_FINANCE_MIN=960      # 16h
SLA_GM_MIN=1440          # 24h

# ── Optional: log level (trace|debug|info|warn|error|fatal) ──
LOG_LEVEL=info
